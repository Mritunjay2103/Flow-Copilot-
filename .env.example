# Flow Copilot — environment template (no secrets)
#
# Local Ollama recording:
#   AI_MODE=ollama
#   copy this file to .env.local and pull the model: ollama pull qwen3:4b
#
# Public / Vercel deployment (required):
#   AI_MODE=demo
#   Vercel cannot reach Ollama on your laptop. Always set demo mode explicitly.
#
# auto: try Ollama if reachable, otherwise use the deterministic demo engine.

AI_MODE=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m
